{
  "name": "uptime-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c blue,magenta \"pnpm --filter @uptime/api dev\" \"pnpm --filter @uptime/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~6.0.3"
  }
}
